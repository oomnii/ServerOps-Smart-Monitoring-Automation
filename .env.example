# ServerOps environment template
#
# Copy this file to backend/.env before starting the Phase 1 API.
# Replace every placeholder before use.
# This file contains no real passwords, API keys, tokens, or credentials.
# Do not commit a filled-in .env file.

# --- Django (Phase 1+) ---
# Generate a new random string before running Django. This value is a placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# SQLite file path, relative to the backend working directory.
SQLITE_DB_PATH=db.sqlite3

# --- Local API (Phase 1+) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- React / Vite (Phase 2+) ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Vite does not read this root file. frontend/.env.example leaves
# VITE_API_BASE_URL empty so the browser uses the Vite /api proxy.
VITE_API_BASE_URL=

# The dashboard polls every 5 seconds in code. This value is not read at runtime.
DASHBOARD_REFRESH_MS=5000

# Browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Alert thresholds (Phase 3+) ---
# Documented here only. The React app compares CPU and memory to 80 in code.
CPU_ALERT_THRESHOLD_PERCENT=80
RAM_ALERT_THRESHOLD_PERCENT=80

# --- Prometheus (Phase 4+) ---
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=5s
METRICS_PATH=/internal/metrics/
# From a Docker container, 127.0.0.1 is the container itself.
# host.docker.internal is the usual way to reach Django on the Windows host.
PROMETHEUS_SCRAPE_TARGET=host.docker.internal:8000
# Placeholder only. The real token belongs in backend/.env and in
# monitoring/prometheus/secrets/scrape_token. Use the same value in both.
SERVEROPS_METRICS_TOKEN=replace-with-a-random-token

# --- Grafana (Phase 4+) ---
GRAFANA_PORT=3000
# The running Grafana password is not stored here.
# Copy monitoring/grafana/.env.example to monitoring/grafana/.env
# and set a random GF_SECURITY_ADMIN_PASSWORD there.

# --- Ansible (Phase 5+) ---
# The lab does not read environment variables and does not use SSH.
# See automation/ansible/README.md. It configures only its own container.
