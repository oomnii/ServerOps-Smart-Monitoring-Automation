# Copy to monitoring/grafana/.env. The copy is gitignored.
# Choose a random password. Do not commit the filled-in file.
GF_SECURITY_ADMIN_USER=serverops
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-random-password
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
